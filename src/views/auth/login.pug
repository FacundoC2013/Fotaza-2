extends ../layout

block contenido
  .row.justify-content-center
    .col-md-5
      h1.mb-4 Iniciar sesión

      if error
        .alert.alert-danger= error

      form(method="POST", action="/login")
        .mb-3
          label.form-label(for="email") Email
          input.form-control(type="email", name="email", id="email", required)

        .mb-3
          label.form-label(for="password") Contraseña
          input.form-control(type="password", name="password", id="password", required)

        button.btn.btn-primary(type="submit") Entrar

      .mt-3
        p.text-muted Usuarios de prueba:
        ul
          li facundo@fotaza.com / 123456
          li jaquelina@fotaza.com / 123456
          li candela@fotaza.com / 123456