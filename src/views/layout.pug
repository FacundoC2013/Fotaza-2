doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title= titulo || "Fotaza 2"
    link(rel="stylesheet", href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css")

  body
    nav.navbar.navbar-expand-lg.navbar-dark.bg-dark
  .container
    a.navbar-brand.text-white(href="/") Fotaza 2

    form.d-flex.ms-3(method="GET", action="/publicaciones/buscar")
      input.form-control.form-control-sm.me-2(
        type="text",
        name="q",
        placeholder="Buscar..."
      )
      button.btn.btn-outline-light.btn-sm(type="submit") Buscar

    a.btn.btn-link.text-white.ms-2(href="/publicaciones/buscar") Búsqueda avanzada

    .ms-auto.d-flex.align-items-center.gap-2
      if usuario
        a.btn.btn-outline-light.btn-sm(href="/publicaciones/siguiendo") Siguiendo
        a.btn.btn-outline-light.btn-sm(href="/publicaciones/nueva") Nueva publicación
        span.text-white Hola, #{usuario.nombre}
        form.d-inline(method="POST", action="/logout")
          button.btn.btn-outline-light.btn-sm(type="submit") Cerrar sesión
      else
        a.btn.btn-outline-light.btn-sm(href="/login") Iniciar sesión

    main.container.mt-4
      block contenido

    script(src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js")