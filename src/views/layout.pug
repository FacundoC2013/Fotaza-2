doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title= titulo || "Fotaza 2"
    link(rel="stylesheet", href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css")
    link(rel="stylesheet", href="/css/styles.css")

  body
    .fotaza-app
      aside.fotaza-sidebar
        a.fotaza-sidebar-brand(href="/") Fotaza 2

        nav.fotaza-sidebar-nav
          a.fotaza-sidebar-link(href="/") Inicio

          if usuario
            a.fotaza-sidebar-link(href="/publicaciones/siguiendo") Siguiendo
            a.fotaza-sidebar-link(href="/publicaciones/nueva") Crear
            a.fotaza-sidebar-link(href=`/usuarios/${usuario.id_usuario}`) Mi perfil

            .fotaza-sidebar-section Próximamente
            span.fotaza-sidebar-link.fotaza-disabled Notificaciones
            span.fotaza-sidebar-link.fotaza-disabled Mensajes

        .fotaza-sidebar-footer
          if usuario
            .fotaza-user-mini
              .fotaza-avatar= usuario.nombre.charAt(0).toUpperCase()
              .fotaza-user-data
                small Sesión iniciada
                strong #{usuario.nombre}

            form(method="POST", action="/logout")
              button.fotaza-logout(type="submit") Cerrar sesión

          if !usuario
            a.btn.btn-outline-light.btn-sm.w-100(href="/login") Iniciar sesión

      main.fotaza-content
        .fotaza-top-search
          form(method="GET", action="/publicaciones/buscar")
            input.form-control(
              type="text",
              name="q",
              placeholder="Buscar fotos, autores o etiquetas..."
            )
            button.btn.btn-fotaza(type="submit") Buscar

          .fotaza-advanced-search
            a(href="/publicaciones/buscar") Búsqueda avanzada

        block contenido

    script(src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js")