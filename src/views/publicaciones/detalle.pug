extends ../layout

block contenido
  if error
    .alert.alert-danger= error

  if exito
    .alert.alert-success= exito

  a.btn.btn-secondary.mb-3(href="/") Volver a la home

  .card.mb-4
    .card-body
      h1.card-title= publicacion.titulo

      if publicacion.descripcion
        p.card-text= publicacion.descripcion
      else
        p.text-muted Sin descripción.

      if publicacion.autor
        p.mb-1
          strong Autor:
          |  
          a(href=`/usuarios/${publicacion.autor.id_usuario}`) #{publicacion.autor.nombre} #{publicacion.autor.apellido}

        if usuario && !publicacion.esAutor
          .mt-3
            if publicacion.sigueAutor
              form(method="POST", action=`/usuarios/${publicacion.autor.id_usuario}/dejar-de-seguir`)
                input(type="hidden", name="volverA", value=`/publicaciones/${publicacion.id_publicacion}`)
                button.btn.btn-outline-danger.btn-sm(type="submit") Dejar de seguir
            else
              form(method="POST", action=`/usuarios/${publicacion.autor.id_usuario}/seguir`)
                input(type="hidden", name="volverA", value=`/publicaciones/${publicacion.id_publicacion}`)
                button.btn.btn-outline-primary.btn-sm(type="submit") Seguir

      if publicacion.etiquetas && publicacion.etiquetas.length > 0
        p.mt-3.mb-2
          strong Etiquetas:
        .d-flex.flex-wrap.gap-2
          each etiqueta in publicacion.etiquetas
            span.badge.bg-secondary= etiqueta.nombre
      else
        p.text-muted Esta publicación no tiene etiquetas.

  h2 Imágenes de la publicación

  if !publicacion.imagenes || publicacion.imagenes.length === 0
    .alert.alert-info
      | Esta publicación no tiene imágenes cargadas.
  else
    .row
      each imagen in publicacion.imagenes
        .col-md-6.mb-4
          .card.h-100
            .card-body
              h5.card-title= imagen.titulo || "Imagen sin título"

              if imagen.ruta_archivo
                img.img-fluid.rounded.mb-3(src=imagen.ruta_archivo, alt=imagen.titulo || "Imagen de la publicación")

              if imagen.descripcion
                p.card-text= imagen.descripcion

              p.mb-1
                strong Ruta:
                |  #{imagen.ruta_archivo}

              p.mb-1
                strong Licencia:
                |  #{imagen.licencia}

              if imagen.marca_agua
                p.mb-1
                  strong Marca de agua:
                  |  Sí
                if imagen.texto_marca_agua
                  p.mb-1
                    strong Texto:
                    |  #{imagen.texto_marca_agua}
              else
                p.mb-1
                  strong Marca de agua:
                  |  No

              p.mb-1
                strong Comentarios:
                if imagen.comentarios_abiertos
                  |  abiertos
                else
                  |  cerrados

              p.mb-1
                strong Valoración:
                if imagen.promedioValoraciones
                  |  #{imagen.promedioValoraciones} / 5
                else
                  |  Sin valoraciones todavía

              p.mb-1
                strong Cantidad de votos:
                |  #{imagen.cantidadValoraciones}

              hr

              h6 Comentarios

              if imagen.comentarios && imagen.comentarios.length > 0
                each comentario in imagen.comentarios
                  .border.rounded.p-2.mb-2
                    if comentario.autorComentario
                      strong #{comentario.autorComentario.nombre} #{comentario.autorComentario.apellido}
                    else
                      strong Usuario
                    p.mb-0= comentario.texto
              else
                p.text-muted Todavía no hay comentarios para esta imagen.

              if usuario
                if imagen.comentarios_abiertos
                  form(method="POST", action=`/imagenes/${imagen.id_imagen}/comentarios`)
                    .mb-2
                      label.form-label(for=`comentario-${imagen.id_imagen}`) Agregar comentario
                      textarea.form-control(
                        id=`comentario-${imagen.id_imagen}`,
                        name="texto",
                        rows="2",
                        required
                      )
                    button.btn.btn-outline-primary.btn-sm(type="submit") Comentar
                else
                  p.text-muted Los comentarios de esta imagen estan cerrados.
              else
                p.text-muted
                  | Para comentar tenes que 
                  a(href="/login") iniciar sesion
                  | .

              hr

              h6 Valorar imagen

              if usuario
                if publicacion.esAutor
                  p.text-muted No podes valorar una imagen de tu propia publicacion.
                else if imagen.yaValoro
                  p.text-muted Ya valoraste esta imagen.
                else
                  form(method="POST", action=`/imagenes/${imagen.id_imagen}/valoraciones`)
                    .mb-2
                      label.form-label(for=`puntaje-${imagen.id_imagen}`) Puntaje
                      select.form-select(
                        id=`puntaje-${imagen.id_imagen}`,
                        name="puntaje",
                        required
                      )
                        option(value="") Seleccioná un puntaje
                        option(value="1") 1 - Muy mala
                        option(value="2") 2 - Mala
                        option(value="3") 3 - Regular
                        option(value="4") 4 - Muy buena
                        option(value="5") 5 - Excelente
                    button.btn.btn-outline-success.btn-sm(type="submit") Valorar imagen
              else
                p.text-muted
                  | Para valorar tenes que 
                  a(href="/login") iniciar sesion
                  | .

              .mt-3
                button.btn.btn-outline-warning.btn-sm(type="button", disabled) Me interesa