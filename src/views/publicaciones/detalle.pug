extends ../layout

block contenido
  if error
    .alert.alert-danger= error

  if exito
    .alert.alert-success= exito

  section.fotaza-detail-header
    a.fotaza-back-link(href="/") ← Volver al inicio

    .fotaza-detail-title-row
      if publicacion.autor
        .fotaza-profile-avatar-sm= publicacion.autor.nombre.charAt(0).toUpperCase()
      else
        .fotaza-profile-avatar-sm U

      .flex-grow-1
        p.fotaza-eyebrow Publicación
        h1= publicacion.titulo

        if publicacion.autor
          p.fotaza-muted.mb-0
            | Por 
            a.fotaza-link(href=`/usuarios/${publicacion.autor.id_usuario}`) #{publicacion.autor.nombre} #{publicacion.autor.apellido}

    if publicacion.descripcion
      p.fotaza-detail-description= publicacion.descripcion
    else
      p.fotaza-muted Sin descripción.

    if publicacion.etiquetas && publicacion.etiquetas.length > 0
      .d-flex.flex-wrap.gap-2.mt-3
        each etiqueta in publicacion.etiquetas
          a.badge.fotaza-chip.text-decoration-none(href=`/publicaciones/buscar?q=${etiqueta.nombre}`)= etiqueta.nombre
    else
      p.fotaza-muted.mt-3 Esta publicación no tiene etiquetas.

    if publicacion.autor && usuario && !publicacion.esAutor
      .mt-3
        if publicacion.sigueAutor
          form(method="POST", action=`/usuarios/${publicacion.autor.id_usuario}/dejar-de-seguir`)
            input(type="hidden", name="volverA", value=`/publicaciones/${publicacion.id_publicacion}`)
            button.btn.btn-outline-danger.btn-sm(type="submit") Dejar de seguir
        else
          form(method="POST", action=`/usuarios/${publicacion.autor.id_usuario}/seguir`)
            input(type="hidden", name="volverA", value=`/publicaciones/${publicacion.id_publicacion}`)
            button.btn.btn-fotaza.btn-sm(type="submit") Seguir autor

  h2.fotaza-section-title Imágenes

  if !publicacion.imagenes || publicacion.imagenes.length === 0
    .alert.alert-info
      if usuario
        | Esta publicación no tiene imágenes cargadas.
      else
        | Esta publicación no tiene imágenes públicas disponibles.
  else
    each imagen in publicacion.imagenes
      .fotaza-detail-card
        .row.g-4
          .col-lg-7
            .fotaza-detail-image-box
              if imagen.ruta_archivo
                img.fotaza-detail-img(
                  src=imagen.ruta_archivo,
                  alt=imagen.titulo || "Imagen de la publicación"
                )

              if imagen.marca_agua
                .fotaza-watermark
                  if imagen.texto_marca_agua
                    | #{imagen.texto_marca_agua}
                  else
                    | Fotaza 2

          .col-lg-5
            .fotaza-detail-info
              h3= imagen.titulo || "Imagen sin título"

              if imagen.descripcion
                p= imagen.descripcion
              else
                p.fotaza-muted Sin descripción.

              .fotaza-info-list
                p
                  strong Licencia:
                  span.fotaza-license.ms-2= imagen.licencia

                p
                  strong Marca de agua:
                  if imagen.marca_agua
                    span.ms-2 Sí
                  else
                    span.ms-2 No

                p
                  strong Comentarios:
                  if imagen.comentarios_abiertos
                    span.ms-2 Abiertos
                  else
                    span.ms-2 Cerrados
                    if usuario && publicacion.esAutor
                  form.mt-2(method="POST", action=`/imagenes/${imagen.id_imagen}/comentarios/estado`)
                    if imagen.comentarios_abiertos
                      button.btn.btn-outline-danger.btn-sm(type="submit") Cerrar comentarios
                    else
                      button.btn.btn-outline-success.btn-sm(type="submit") Abrir comentarios

                p
                  strong Valoración:
                  if imagen.promedioValoraciones
                    span.ms-2 #{imagen.promedioValoraciones} / 5
                  else
                    span.ms-2 Sin valoraciones

                p
                  strong Votos:
                  span.ms-2 #{imagen.cantidadValoraciones}

              hr

              h4 Comentarios

              if imagen.comentarios && imagen.comentarios.length > 0
                .fotaza-comments
                  each comentario in imagen.comentarios
                    .fotaza-comment
                      if comentario.autorComentario
                        strong #{comentario.autorComentario.nombre} #{comentario.autorComentario.apellido}
                      else
                        strong Usuario
                      p.mb-0= comentario.texto
              else
                p.fotaza-muted Todavía no hay comentarios.

              if usuario
                if imagen.comentarios_abiertos
                  form.mt-3(method="POST", action=`/imagenes/${imagen.id_imagen}/comentarios`)
                    .mb-2
                      label.form-label(for=`comentario-${imagen.id_imagen}`) Agregar comentario
                      textarea.form-control(
                        id=`comentario-${imagen.id_imagen}`,
                        name="texto",
                        rows="2",
                        required
                      )
                    button.btn.btn-outline-dark.btn-sm(type="submit") Comentar
                else
                  p.fotaza-muted Los comentarios de esta imagen están cerrados.
              else
                p.fotaza-muted
                  | Para comentar tenés que 
                  a.fotaza-link(href="/login") iniciar sesión
                  | .

              hr

              h4 Valorar imagen

              if usuario
                if publicacion.esAutor
                  p.fotaza-muted No podés valorar una imagen de tu propia publicación.
                else if imagen.yaValoro
                  p.fotaza-muted Ya valoraste esta imagen.
                else
                  form(method="POST", action=`/imagenes/${imagen.id_imagen}/valoraciones`)
                    .mb-2
                      label.form-label(for=`puntaje-${imagen.id_imagen}`) Puntaje
                      select.form-select(
                        id=`puntaje-${imagen.id_imagen}`,
                        name="puntaje",
                        required
                      )
                        option(value="") Seleccioná un puntaje
                        option(value="1") 1 - Muy mala
                        option(value="2") 2 - Mala
                        option(value="3") 3 - Regular
                        option(value="4") 4 - Muy buena
                        option(value="5") 5 - Excelente
                    button.btn.btn-fotaza.btn-sm(type="submit") Valorar imagen
              else
                p.fotaza-muted
                  | Para valorar tenés que 
                  a.fotaza-link(href="/login") iniciar sesión
                  | .

              .mt-3
                button.btn.btn-outline-secondary.btn-sm(type="button", disabled) Me interesa