extends ../layout

block contenido
  section.fotaza-header
    p.fotaza-eyebrow Búsqueda
    h1 Buscar publicaciones
    p Encontrá fotos por texto, licencia, etiqueta o valoración.

  form.fotaza-filter-panel(method="GET", action="/publicaciones/buscar")
    .row.g-3.align-items-end
      .col-md-4
        label.fotaza-filter-label Texto
        input.form-control(
          type="text",
          name="q",
          placeholder="Título, autor, imagen o etiqueta..."
          value=busqueda || ""
        )

      .col-md-3
        label.fotaza-filter-label Licencia
        select.form-select(name="licencia")
          option(value="") Todas
          option(value="sin_copyright", selected=licencia === "sin_copyright") Sin copyright
          option(value="con_copyright", selected=licencia === "con_copyright") Con copyright

      .col-md-3
        label.fotaza-filter-label Orden
        select.form-select(name="orden")
          option(value="recientes", selected=orden === "recientes") Más recientes
          option(value="antiguas", selected=orden === "antiguas") Más antiguas
          option(value="titulo", selected=orden === "titulo") Título
          option(value="mejor_valoradas", selected=orden === "mejor_valoradas") Mejor valoradas

      .col-md-2
        button.btn.btn-fotaza.w-100(type="submit") Buscar

    if etiqueta
      input(type="hidden", name="etiqueta", value=etiqueta)

  if busqueda || licencia || etiqueta || (orden && orden !== "recientes")
    .fotaza-applied-filters
      strong Filtros:
      if busqueda
        span Texto: "#{busqueda}"
      if licencia
        span Licencia: #{licencia}
      if etiqueta
        span Etiqueta: #{etiqueta}
      if orden
        span Orden: #{orden}
      a(href="/publicaciones/buscar") Limpiar

  if mensaje
    .alert.alert-info= mensaje

  if publicaciones && publicaciones.length > 0
    h2.fotaza-section-title Resultados encontrados

    .fotaza-grid
      each publicacion in publicaciones
        article.fotaza-card
          if publicacion.imagenes && publicacion.imagenes.length > 0
            a.fotaza-image-link(href=`/publicaciones/${publicacion.id_publicacion}`)
              img.fotaza-card-img(
                src=publicacion.imagenes[0].ruta_archivo,
                alt=publicacion.imagenes[0].titulo || "Imagen de la publicación"
              )
              span.fotaza-hover-btn Ver detalle
          else
            .fotaza-no-image Sin imagen

          .fotaza-card-body
            h2.fotaza-card-title= publicacion.titulo

            if publicacion.imagenes && publicacion.imagenes.length > 0
              if publicacion.imagenes[0].titulo
                p.fotaza-muted.mb-2= publicacion.imagenes[0].titulo

              p.mb-2
                span.fotaza-license= publicacion.imagenes[0].licencia

            if publicacion.descripcion
              p.fotaza-card-text= publicacion.descripcion
            else
              p.fotaza-muted Sin descripción.

            if publicacion.autor
              p.fotaza-muted.mb-2
                | Por 
                a.fotaza-link(href=`/usuarios/${publicacion.autor.id_usuario}`) #{publicacion.autor.nombre} #{publicacion.autor.apellido}

            .fotaza-card-stats
              span
                strong Valoración:
                if publicacion.cantidadValoraciones > 0
                  |  #{publicacion.promedioValoracion.toFixed(1)} / 5
                else
                  |  Sin votos
              span
                strong Votos:
                |  #{publicacion.cantidadValoraciones}

            if publicacion.etiquetas && publicacion.etiquetas.length > 0
              .d-flex.flex-wrap.gap-2.mt-3
                each etiquetaItem in publicacion.etiquetas
                  a.badge.fotaza-chip.text-decoration-none(href="/publicaciones/buscar?etiqueta=" + encodeURIComponent(etiquetaItem.nombre))= etiquetaItem.nombre