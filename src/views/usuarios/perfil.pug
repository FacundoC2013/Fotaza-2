extends ../layout

block contenido
  if error
    .alert.alert-danger= error

  if exito
    .alert.alert-success= exito

  section.fotaza-profile-header
    .fotaza-profile-main
      .fotaza-profile-avatar-lg= perfil.nombre.charAt(0).toUpperCase()

      .flex-grow-1
        p.fotaza-eyebrow Perfil
        h1 #{perfil.nombre} #{perfil.apellido}

        if perfil.biografia
          p.fotaza-profile-bio= perfil.biografia
        else
          p.fotaza-muted Este usuario no tiene biografía.

        .fotaza-profile-stats
          .fotaza-stat
            strong #{cantidadSeguidores}
            span Seguidores
          .fotaza-stat
            strong #{cantidadSeguidos}
            span Seguidos
          .fotaza-stat
            strong #{perfil.publicaciones ? perfil.publicaciones.length : 0}
            span Publicaciones

    .fotaza-profile-actions
      if usuario && !esPerfilPropio
        if siguePerfil
          form(method="POST", action=`/usuarios/${perfil.id_usuario}/dejar-de-seguir`)
            input(type="hidden", name="volverA", value=`/usuarios/${perfil.id_usuario}`)
            button.btn.btn-outline-danger.btn-sm(type="submit") Dejar de seguir
        else
          form(method="POST", action=`/usuarios/${perfil.id_usuario}/seguir`)
            input(type="hidden", name="volverA", value=`/usuarios/${perfil.id_usuario}`)
            button.btn.btn-fotaza.btn-sm(type="submit") Seguir

      if esPerfilPropio
        span.fotaza-own-profile Este es tu perfil

  h2.fotaza-section-title Publicaciones

  if !perfil.publicaciones || perfil.publicaciones.length === 0
    .alert.alert-info
      | Este usuario todavía no tiene publicaciones visibles.
  else
    .fotaza-grid
      each publicacion in perfil.publicaciones
        article.fotaza-card
          if publicacion.imagenes && publicacion.imagenes.length > 0
            a.fotaza-image-link(href=`/publicaciones/${publicacion.id_publicacion}`)
              img.fotaza-card-img(
                src=publicacion.imagenes[0].ruta_archivo,
                alt=publicacion.imagenes[0].titulo || "Imagen de la publicación"
              )
              span.fotaza-hover-btn Ver detalle
          else
            .fotaza-no-image Sin imagen

          .fotaza-card-body
            h2.fotaza-card-title= publicacion.titulo

            if publicacion.imagenes && publicacion.imagenes.length > 0
              if publicacion.imagenes[0].titulo
                p.fotaza-muted.mb-2= publicacion.imagenes[0].titulo

              p.mb-2
                span.fotaza-license= publicacion.imagenes[0].licencia

            if publicacion.descripcion
              p.fotaza-card-text= publicacion.descripcion
            else
              p.fotaza-muted Sin descripción.